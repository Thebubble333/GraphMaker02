      { "xMin": 30, "xMax": 40, "frequency": 3 }
    ],
    "config": {
      "xRange": [0, 40],
      "yRange": [0, 10],
      "majorStep": [10, 2],
      "axisLabels": ["Score", "Frequency"]
    }
  }
