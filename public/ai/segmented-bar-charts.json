{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebubble333.github.io/GraphMaker02/ai/segmented-bar-charts.json",
  "slug": "segmented-bar-charts",
  "name": "Segmented Bar Charts",
  "category": "statistics",
  "description": "Create stacked / percentage segmented bar charts with patterns and legends.",
  "defaultWidthCm": 14,
  "defaultHeightCm": 10,
  "deepLinkFormat": "https://thebubble333.github.io/GraphMaker02/?tool=segmented-bar-charts&config=<URL_ENCODED_JSON>",
  "schema": {
    "type": "object",
    "properties": {
      "chartTitle": {
        "type": "string"
      },
      "bars": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "label",
            "segments"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string"
                  },
                  "pattern": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "showLegend": {
        "type": "boolean"
      },
      "studentMode": {
        "type": "boolean"
      },
      "config": {
        "type": "object",
        "description": "Optional partial GraphConfig overrides for axes, grid, labels, and styling.",
        "properties": {
          "xRange": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "yRange": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "majorStep": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "subdivisions": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "axisLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "fontSize": {
            "type": "number",
            "description": "Font size in pt (default 11)"
          },
          "showMajorGrid": {
            "type": "boolean"
          },
          "showMinorGrid": {
            "type": "boolean"
          },
          "showBorder": {
            "type": "boolean"
          },
          "piXAxis": {
            "type": "boolean"
          },
          "piYAxis": {
            "type": "boolean"
          },
          "showZeroLabel": {
            "type": "boolean",
            "description": "Show or hide the origin 0/O label. When omitted, autoZeroLabel applies automatically (matching browser behavior)."
          },
          "showYZeroLabel": {
            "type": "boolean",
            "description": "Separate toggle for the Y-axis zero label."
          },
          "autoZeroLabel": {
            "type": "boolean",
            "description": "When true (default on Cartesian graphs), hides the origin 0 label whenever the x-axis crosses strictly inside the y-range."
          },
          "originLabelContent": {
            "type": "string",
            "enum": [
              "auto",
              "0",
              "O"
            ],
            "description": "Origin label glyph: \"auto\", \"0\", or italic \"O\"."
          },
          "originLabelOffset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "description": "Pixel offset { x, y } for nudging the origin label."
          },
          "offsetXAxisLabelX": {
            "type": "number",
            "description": "Horizontal pixel nudge for the X-axis title."
          },
          "offsetXAxisLabelY": {
            "type": "number",
            "description": "Vertical pixel nudge for the X-axis title."
          },
          "offsetYAxisLabelX": {
            "type": "number",
            "description": "Horizontal pixel nudge for the Y-axis title."
          },
          "offsetYAxisLabelY": {
            "type": "number",
            "description": "Vertical pixel nudge for the Y-axis title."
          },
          "studentMode": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "example": {
    "chartTitle": "Survey Results (%)",
    "bars": [
      {
        "label": "Year 9",
        "segments": [
          {
            "label": "Yes",
            "value": 60,
            "color": "#3b82f6"
          },
          {
            "label": "No",
            "value": 40,
            "color": "#e2e8f0"
          }
        ]
      },
      {
        "label": "Year 10",
        "segments": [
          {
            "label": "Yes",
            "value": 45,
            "color": "#3b82f6"
          },
          {
            "label": "No",
            "value": 55,
            "color": "#e2e8f0"
          }
        ]
      }
    ],
    "config": {
      "yRange": [
        0,
        100
      ],
      "majorStep": [
        1,
        20
      ],
      "axisLabels": [
        "Cohort",
        "Percentage (%)"
      ]
    }
  },
  "deepLinkExample": "https://thebubble333.github.io/GraphMaker02/?tool=segmented-bar-charts&config=%7B%22chartTitle%22%3A%22Survey+Results+%28%25%29%22%2C%22bars%22%3A%5B%7B%22label%22%3A%22Year+9%22%2C%22segments%22%3A%5B%7B%22label%22%3A%22Yes%22%2C%22value%22%3A60%2C%22color%22%3A%22%233b82f6%22%7D%2C%7B%22label%22%3A%22No%22%2C%22value%22%3A40%2C%22color%22%3A%22%23e2e8f0%22%7D%5D%7D%2C%7B%22label%22%3A%22Year+10%22%2C%22segments%22%3A%5B%7B%22label%22%3A%22Yes%22%2C%22value%22%3A45%2C%22color%22%3A%22%233b82f6%22%7D%2C%7B%22label%22%3A%22No%22%2C%22value%22%3A55%2C%22color%22%3A%22%23e2e8f0%22%7D%5D%7D%5D%2C%22config%22%3A%7B%22yRange%22%3A%5B0%2C100%5D%2C%22majorStep%22%3A%5B1%2C20%5D%2C%22axisLabels%22%3A%5B%22Cohort%22%2C%22Percentage+%28%25%29%22%5D%7D%7D"
}
