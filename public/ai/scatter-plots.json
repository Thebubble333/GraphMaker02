{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccombe.github.io/GraphMaker02/ai/scatter-plots.json",
  "slug": "scatter-plots",
  "name": "Scatter Plots",
  "category": "statistics",
  "description": "Plot bivariate (x, y) scatter data with optional linear regression line of best fit and residual views.",
  "defaultWidthCm": 14,
  "defaultHeightCm": 10,
  "deepLinkFormat": "https://mccombe.github.io/GraphMaker02/?tool=scatter-plots&config=<URL_ENCODED_JSON>",
  "schema": {
    "type": "object",
    "properties": {
      "points": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "rawData": {
        "type": "string",
        "description": "Tab/comma-separated x y rows"
      },
      "showRegression": {
        "type": "boolean"
      },
      "viewMode": {
        "type": "string",
        "enum": [
          "scatter",
          "residual",
          "squared-residual"
        ]
      },
      "studentMode": {
        "type": "boolean"
      },
      "config": {
        "type": "object",
        "description": "Optional partial GraphConfig overrides for axes, grid, labels, and styling.",
        "properties": {
          "xRange": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "yRange": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "majorStep": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "subdivisions": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "axisLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "fontSize": {
            "type": "number",
            "description": "Font size in pt (default 11)"
          },
          "showMajorGrid": {
            "type": "boolean"
          },
          "showMinorGrid": {
            "type": "boolean"
          },
          "showBorder": {
            "type": "boolean"
          },
          "piXAxis": {
            "type": "boolean"
          },
          "piYAxis": {
            "type": "boolean"
          },
          "studentMode": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "example": {
    "points": [
      [
        1,
        2.1
      ],
      [
        2,
        3.8
      ],
      [
        3,
        5.2
      ],
      [
        4,
        6.9
      ],
      [
        5,
        8.4
      ],
      [
        6,
        9.7
      ]
    ],
    "showRegression": true,
    "config": {
      "xRange": [
        0,
        7
      ],
      "yRange": [
        0,
        12
      ],
      "majorStep": [
        1,
        2
      ],
      "axisLabels": [
        "Hours Studied",
        "Score"
      ]
    }
  },
  "deepLinkExample": "https://mccombe.github.io/GraphMaker02/?tool=scatter-plots&config=%7B%22points%22%3A%5B%5B1%2C2.1%5D%2C%5B2%2C3.8%5D%2C%5B3%2C5.2%5D%2C%5B4%2C6.9%5D%2C%5B5%2C8.4%5D%2C%5B6%2C9.7%5D%5D%2C%22showRegression%22%3Atrue%2C%22config%22%3A%7B%22xRange%22%3A%5B0%2C7%5D%2C%22yRange%22%3A%5B0%2C12%5D%2C%22majorStep%22%3A%5B1%2C2%5D%2C%22axisLabels%22%3A%5B%22Hours+Studied%22%2C%22Score%22%5D%7D%7D"
}
