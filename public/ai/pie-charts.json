{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccombe.github.io/GraphMaker02/ai/pie-charts.json",
  "slug": "pie-charts",
  "name": "Pie Charts",
  "category": "statistics",
  "description": "Create pie or donut charts with percentage/value/combined labels, exploded slices, and legends.",
  "defaultWidthCm": 14,
  "defaultHeightCm": 12,
  "deepLinkFormat": "https://mccombe.github.io/GraphMaker02/?tool=pie-charts&config=<URL_ENCODED_JSON>",
  "schema": {
    "type": "object",
    "properties": {
      "chartTitle": {
        "type": "string"
      },
      "donutRatio": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.8
      },
      "slices": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "label",
            "value"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "explodeOffset": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "pieConfig": {
        "type": "object",
        "properties": {
          "labelType": {
            "type": "string",
            "enum": [
              "name",
              "value",
              "percent",
              "combined",
              "none"
            ]
          },
          "labelPosition": {
            "type": "string",
            "enum": [
              "inside",
              "outside",
              "legend"
            ]
          }
        },
        "additionalProperties": false
      },
      "studentMode": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "example": {
    "chartTitle": "Transport to School",
    "slices": [
      {
        "label": "Walk",
        "value": 15,
        "color": "#3b82f6"
      },
      {
        "label": "Bus",
        "value": 12,
        "color": "#10b981",
        "explodeOffset": 14
      },
      {
        "label": "Car",
        "value": 8,
        "color": "#ef4444"
      },
      {
        "label": "Bike",
        "value": 5,
        "color": "#f59e0b"
      }
    ]
  },
  "deepLinkExample": "https://mccombe.github.io/GraphMaker02/?tool=pie-charts&config=%7B%22chartTitle%22%3A%22Transport+to+School%22%2C%22slices%22%3A%5B%7B%22label%22%3A%22Walk%22%2C%22value%22%3A15%2C%22color%22%3A%22%233b82f6%22%7D%2C%7B%22label%22%3A%22Bus%22%2C%22value%22%3A12%2C%22color%22%3A%22%2310b981%22%2C%22explodeOffset%22%3A14%7D%2C%7B%22label%22%3A%22Car%22%2C%22value%22%3A8%2C%22color%22%3A%22%23ef4444%22%7D%2C%7B%22label%22%3A%22Bike%22%2C%22value%22%3A5%2C%22color%22%3A%22%23f59e0b%22%7D%5D%7D"
}
