{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebubble333.github.io/GraphMaker02/ai/bar-charts.json",
  "slug": "bar-charts",
  "name": "Bar Charts",
  "category": "statistics",
  "description": "Create single-series or grouped column/bar charts with optional value labels and legends.",
  "defaultWidthCm": 14,
  "defaultHeightCm": 10,
  "deepLinkFormat": "https://thebubble333.github.io/GraphMaker02/?tool=bar-charts&config=<URL_ENCODED_JSON>",
  "schema": {
    "type": "object",
    "properties": {
      "chartTitle": {
        "type": "string"
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "label",
            "values"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Shorthand for single-series categories"
      },
      "values": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "description": "Shorthand for single-series values"
      },
      "showValues": {
        "type": "boolean"
      },
      "showLegend": {
        "type": "boolean"
      },
      "config": {
        "type": "object",
        "description": "Optional partial GraphConfig overrides for axes, grid, labels, and styling.",
        "properties": {
          "xRange": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "yRange": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "majorStep": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "subdivisions": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "axisLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "fontSize": {
            "type": "number",
            "description": "Font size in pt (default 11)"
          },
          "showMajorGrid": {
            "type": "boolean"
          },
          "showMinorGrid": {
            "type": "boolean"
          },
          "showBorder": {
            "type": "boolean"
          },
          "piXAxis": {
            "type": "boolean"
          },
          "piYAxis": {
            "type": "boolean"
          },
          "showZeroLabel": {
            "type": "boolean",
            "description": "Show or hide the origin 0/O label. When omitted, autoZeroLabel applies automatically (matching browser behavior)."
          },
          "showYZeroLabel": {
            "type": "boolean",
            "description": "Separate toggle for the Y-axis zero label."
          },
          "autoZeroLabel": {
            "type": "boolean",
            "description": "When true (default on Cartesian graphs), hides the origin 0 label whenever the x-axis crosses strictly inside the y-range."
          },
          "originLabelContent": {
            "type": "string",
            "enum": [
              "auto",
              "0",
              "O"
            ],
            "description": "Origin label glyph: \"auto\", \"0\", or italic \"O\"."
          },
          "originLabelOffset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "description": "Pixel offset { x, y } for nudging the origin label."
          },
          "offsetXAxisLabelX": {
            "type": "number",
            "description": "Horizontal pixel nudge for the X-axis title."
          },
          "offsetXAxisLabelY": {
            "type": "number",
            "description": "Vertical pixel nudge for the X-axis title."
          },
          "offsetYAxisLabelX": {
            "type": "number",
            "description": "Horizontal pixel nudge for the Y-axis title."
          },
          "offsetYAxisLabelY": {
            "type": "number",
            "description": "Vertical pixel nudge for the Y-axis title."
          },
          "studentMode": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "example": {
    "chartTitle": "Favourite Sport",
    "labels": [
      "Soccer",
      "Tennis",
      "Swimming",
      "Basketball"
    ],
    "values": [
      14,
      9,
      11,
      6
    ],
    "showValues": true,
    "config": {
      "yRange": [
        0,
        16
      ],
      "majorStep": [
        1,
        2
      ],
      "axisLabels": [
        "Sport",
        "Students"
      ]
    }
  },
  "deepLinkExample": "https://thebubble333.github.io/GraphMaker02/?tool=bar-charts&config=%7B%22chartTitle%22%3A%22Favourite+Sport%22%2C%22labels%22%3A%5B%22Soccer%22%2C%22Tennis%22%2C%22Swimming%22%2C%22Basketball%22%5D%2C%22values%22%3A%5B14%2C9%2C11%2C6%5D%2C%22showValues%22%3Atrue%2C%22config%22%3A%7B%22yRange%22%3A%5B0%2C16%5D%2C%22majorStep%22%3A%5B1%2C2%5D%2C%22axisLabels%22%3A%5B%22Sport%22%2C%22Students%22%5D%7D%7D"
}
